root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{swift,c,h,cpp,hpp,metal}]
indent_style = space
indent_size = 4

[*.{sh,py}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.patch]
# Patch files must stay byte for byte; chiaki-ng's hunks use tabs.
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset

[*.{plist,entitlements}]
indent_style = tab

[{LICENSE,licenses/*}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
