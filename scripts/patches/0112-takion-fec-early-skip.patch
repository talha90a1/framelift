  */
+/*
+ * FEC-aware early skip, ported from P5M patch 0052 (beecrepaldi-afk/P5M, AGPL-3.0).
+ *
+ * The queue normally waits up to TAKION_AV_REORDER_TIMEOUT_US for a missing video packet. When
+ * the unit indices prove how many units of the current frame are gone and the frame's FEC
+ * units can still rebuild them, waiting buys nothing: the frame can be completed now, so the
+ * gap is skipped at once instead of holding every packet behind it for ~16 ms.
+ */
+
+// Units of the current frame not delivered so far: expected up to last_unit minus received.
+// Counts lost source and FEC units alike; timeout skips are included naturally.
+static unsigned takion_fec_frame_erasures(const ChiakiTakion *takion)
+{
+	const unsigned expected = (unsigned)takion->fec_last_unit + 1;
+	return takion->fec_received <= expected ? expected - takion->fec_received : UINT32_MAX;
+}
+
+static void takion_fec_note_delivered(ChiakiTakion *takion, const ChiakiTakionAVPacket *packet)
+{
+	if(!packet->is_video)
+		return;
+	if(!takion->fec_frame_valid || packet->frame_index != takion->fec_frame_index)
+	{
+		takion->fec_frame_valid = true;
+		takion->fec_frame_index = packet->frame_index;
+		takion->fec_received = 0;
+	}
+	takion->fec_last_unit = packet->unit_index;
+	takion->fec_units_total = packet->units_in_frame_total;
+	takion->fec_units_fec = packet->units_in_frame_fec;
+	takion->fec_received++;
+}
+
+// Skip early only if the gap fits in this frame's FEC budget and the unit indices confirm
+// how many packets were really lost.
+static bool takion_fec_covers_gap(ChiakiTakion *takion, ChiakiReorderQueue *queue, uint64_t missing)
+{
+	uint64_t seq_num;
+	void *user;
+	if(!takion->fec_frame_valid || missing == 0 || !chiaki_reorder_queue_peek(queue, missing, &seq_num, &user))
+		return false;
+	const ChiakiTakionAVPacket *next = &((TakionAVPacketEntry *)user)->packet;
+	if(!next->is_video)
+		return false;
+	const unsigned erased = takion_fec_frame_erasures(takion);
+	if(erased == UINT32_MAX)
+		return false;
+	if(next->frame_index == takion->fec_frame_index)
+	{
+		// The gap is inside the current frame.
+		if(next->units_in_frame_total != takion->fec_units_total
+				|| next->units_in_frame_fec != takion->fec_units_fec
+				|| next->unit_index <= takion->fec_last_unit
+				|| (uint64_t)next->unit_index - takion->fec_last_unit - 1 != missing)
+			return false;
+		return (uint64_t)erased + missing <= takion->fec_units_fec;
+	}
+	// The gap spans the tail of the current frame and the head of the next one.
+	if(next->frame_index != (ChiakiSeqNum16)(takion->fec_frame_index + 1))
+		return false;
+	const unsigned source_count = takion->fec_units_total > takion->fec_units_fec
+		? takion->fec_units_total - takion->fec_units_fec : 0;
+	if(takion->fec_received < source_count || erased > takion->fec_units_fec)
+		return false;
+	const unsigned tail = takion->fec_units_total > (unsigned)takion->fec_last_unit + 1
+		? takion->fec_units_total - (unsigned)takion->fec_last_unit - 1 : 0;
+	if((uint64_t)tail + next->unit_index != missing || next->unit_index > next->units_in_frame_fec)
+		return false;
+	return (uint64_t)erased + tail <= takion->fec_units_fec;
+}
+
+// One INFO line every 10 s when the reorder queue had to skip anything.
+static void takion_reorder_log(ChiakiTakion *takion, int64_t now)
+{
+	if(!takion->reorder_window_start_us)
+		takion->reorder_window_start_us = now;
+	if(now - takion->reorder_window_start_us < 10000000)
+		return;
+	if(takion->reorder_timeout_skips || takion->reorder_fec_skips)
+		CHIAKI_LOGI(takion->log, "Takion AV reorder 10s: gave up on a lost packet %u times (%.1f ms held in total), "
+				"skipped at once because FEC fills it %u times",
+				takion->reorder_timeout_skips, takion->reorder_timeout_skip_us / 1000.0, takion->reorder_fec_skips);
+	takion->reorder_timeout_skips = 0;
+	takion->reorder_timeout_skip_us = 0;
+	takion->reorder_fec_skips = 0;
+	takion->reorder_window_start_us = now;
+}
