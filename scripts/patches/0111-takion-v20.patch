+	pb_istream_t stream = pb_istream_from_buffer(buf, buf_size);
+	if(!pb_decode(&stream, tkproto_TakionMessage_fields, &msg))
+	{
+		CHIAKI_LOGE(stream_connection->log, "StreamConnection failed to decode a message while waiting for the Takion version ack");
+		return;
+	}
+	if(msg.type == tkproto_TakionMessage_PayloadType_TAKIONPROTOCOLREQUESTACK)
+	{
+		stream_connection->protocol_ack_received = true;
+		if(msg.has_takion_protocol_request_ack && msg.takion_protocol_request_ack.has_takion_protocol_version)
+			stream_connection->protocol_ack_version = msg.takion_protocol_request_ack.takion_protocol_version;
+		stream_connection->state_finished = true;
+		chiaki_cond_signal(&stream_connection->state_cond);
+		return;
+	}
