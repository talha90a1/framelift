+// P5M 0052: checks whether the multistream packet has `streams` streams with the first `coupled`
+// in stereo. Every stream but the last uses self-delimiting framing (RFC 6716, appendix B).
+// Only frame codes 0 and 1, which is what the PS5 sends at a constant bitrate.
+static bool p5m_opus_ms_layout_fits(const uint8_t *buf, size_t size, int streams, int coupled)
+{
